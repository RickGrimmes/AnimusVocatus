# ==============================================================================
# VOCATUS & ANIMUS - VARIABLES DE ENTORNO DE EJEMPLO
# ==============================================================================

# Entorno general
ENV=development
PORT=8000
DEBUG=True

# Base de Datos (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vocatus_animus

# Seguridad & Autenticación
SECRET_KEY=cambiar_por_una_llave_secreta_segura_en_produccion
ALGORITHM=HS256
GUEST_TOKEN_EXPIRE_HOURS=24
HOST_TOKEN_EXPIRE_DAYS=7

# Cloudflare R2 (Almacenamiento compatible S3)
R2_ACCOUNT_ID=tu_cloudflare_account_id
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=vocatus-animus-media
R2_ENDPOINT_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://media.tudominio.com

# Servicio de Correo Transaccional (Resend / Brevo)
RESEND_API_KEY=re_123456789
EMAIL_FROM=Vocatus & Animus <noreply@tudominio.com>

# URLs de Frontend (CORS)
FRONTEND_URL=http://localhost:4321
ADMIN_URL=http://localhost:4321/admin
