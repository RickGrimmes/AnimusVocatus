---
interface Props {
  title: string;
  description?: string;
  theme?: 'editorial' | 'dark';
}

const {
  title,
  description = 'Aevum — Suite para eventos sociales de alta gama (Vocatus, Animus, Live Wall)',
  theme = 'editorial',
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="es" class={theme === 'dark' ? 'bg-[#14161b] text-gray-100' : 'bg-editorial-bg text-gray-900'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class={theme === 'dark' ? 'bg-[#14161b] text-gray-100 min-h-screen' : 'bg-editorial-bg text-gray-900 min-h-screen'}>
    <slot />
  </body>
</html>
