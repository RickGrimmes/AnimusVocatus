---
// Galería editorial de fotos para la pareja (Ricardo & Kiara)
// Diseño estilo Vogue / Kinfolk nupcial con carrusel fluido e interactivo

interface PhotoItem {
  url: string;
  caption: string;
  subtitle: string;
}

const defaultPhotos: PhotoItem[] = [
  {
    url: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=1200&auto=format&fit=crop&q=85',
    caption: 'El Comienzo de Todo',
    subtitle: 'Nuestra historia juntos',
  },
  {
    url: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=1200&auto=format&fit=crop&q=85',
    caption: 'La Promesa',
    subtitle: 'Un sí para siempre',
  },
  {
    url: 'https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=1200&auto=format&fit=crop&q=85',
    caption: 'Caminando Juntos',
    subtitle: 'Hacia nuestro nuevo capítulo',
  },
  {
    url: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=1200&auto=format&fit=crop&q=85',
    caption: 'Eternidad',
    subtitle: 'Celebrando el amor',
  },
];
---

<section class="mt-12">
  <div class="text-center">
    <span class="text-[11px] font-semibold tracking-[0.25em] text-gray-400 uppercase">Memorias</span>
    <h2 class="mt-1.5 font-serif text-2xl font-normal text-gray-950 sm:text-3xl">Nuestra Historia en Fotos</h2>
    <div class="mx-auto mt-3 h-px w-12 bg-gray-200"></div>
  </div>

  <!-- Contenedor del Carrusel Editorial -->
  <div class="relative mt-6">
    <div
      id="couple-carousel-track"
      class="no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 py-2 scroll-smooth"
    >
      {defaultPhotos.map((photo, index) => (
        <div
          class="relative flex-none w-[82%] sm:w-[75%] snap-center overflow-hidden rounded-2xl bg-gray-100 shadow-md transition-transform duration-300"
          data-slide-index={index}
        >
          <!-- Imagen con aspect ratio elegante 4:5 -->
          <div class="aspect-[4/5] w-full overflow-hidden">
            <img
              src={photo.url}
              alt={photo.caption}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            />
          </div>
          <!-- Pie de foto editorial con degradado sutil -->
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-5 text-white">
            <span class="text-[10px] font-semibold tracking-widest text-gray-300 uppercase">
              {photo.subtitle}
            </span>
            <p class="font-serif text-lg font-medium tracking-tight">
              {photo.caption}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Indicadores de posición (Dots) -->
    <div id="carousel-dots" class="mt-4 flex justify-center gap-1.5">
      {defaultPhotos.map((_, i) => (
        <button
          type="button"
          class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-gray-900' : 'w-2 bg-gray-300'}`}
          data-dot-index={i}
          aria-label={`Ir a foto ${i + 1}`}
        ></button>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('couple-carousel-track');
  const dots = document.querySelectorAll('#carousel-dots button');

  if (track && dots.length > 0) {
    track.addEventListener('scroll', () => {
      const scrollLeft = track.scrollLeft;
      const width = track.offsetWidth;
      const activeIdx = Math.round(scrollLeft / (width * 0.8));

      dots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 w-6 bg-gray-900';
        } else {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 w-2 bg-gray-300';
        }
      });
    }, { passive: true });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        const slides = track.querySelectorAll('[data-slide-index]');
        if (slides[idx]) {
          slides[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    });
  }
</script>

