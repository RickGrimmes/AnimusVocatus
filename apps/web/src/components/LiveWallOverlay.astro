---
interface Props {
  slug: string;
  pin?: string;
  title?: string;
}

const { slug, pin = '4821', title = 'Carlos & Sofia' } = Astro.props;
---

<!-- Encabezado superior ambiental -->
<header id="live-header" class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between p-6 sm:p-8 bg-gradient-to-b from-black/80 via-black/40 to-transparent pointer-events-none transition-opacity duration-500">
  
  <div class="pointer-events-auto flex items-center gap-3">
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="text-xs uppercase tracking-widest font-semibold text-white">Muro en Vivo</span>
    </div>
    <div class="h-4 w-px bg-white/20"></div>
    <h1 class="text-xl sm:text-2xl font-serif text-white tracking-wide drop-shadow-md">
      {title}
    </h1>
  </div>

  <div class="pointer-events-auto flex items-center gap-3">
    <div class="px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs text-gray-200">
      <span id="live-counter" class="font-medium">Cargando recuerdos...</span>
    </div>
  </div>

</header>

<!-- Notificacion emergente cuando entra un nuevo recuerdo -->
<div id="live-toast-alert" class="fixed top-24 left-1/2 -translate-x-1/2 z-50 transform -translate-y-12 opacity-0 pointer-events-none transition-all duration-500 ease-out flex items-center gap-3 px-6 py-3 rounded-full bg-white/15 backdrop-blur-xl border border-white/30 text-white shadow-2xl">
  <div class="h-8 w-8 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-300">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  </div>
  <div>
    <p class="text-xs text-emerald-400 uppercase tracking-wider font-semibold">Nuevo recuerdo en vivo</p>
    <p id="live-toast-author" class="text-sm font-bold text-white">Familia Morales</p>
  </div>
</div>

<!-- Tarjeta Flotante con Codigo QR para Escaneo a Distancia -->
<aside id="live-qr-card" class="fixed bottom-6 right-6 z-40 max-w-xs sm:max-w-sm rounded-2xl bg-[#14161b]/90 backdrop-blur-xl border border-white/15 p-5 shadow-2xl transition-all duration-500 transform translate-y-0">
  
  <div class="flex items-start justify-between gap-3 mb-3">
    <div>
      <h3 class="text-sm font-bold text-white tracking-wide">Sube tus fotos y videos</h3>
      <p class="text-xs text-gray-400 mt-0.5">Escanea con tu camara y proyecta tus momentos al instante</p>
    </div>
    <button
      id="btn-toggle-qr"
      type="button"
      class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-white/10 transition"
      aria-label="Minimizar codigo QR"
    >
      <svg id="icon-collapse-qr" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>

  <div id="live-qr-content" class="flex flex-col items-center">
    <div class="relative p-3 bg-white rounded-xl shadow-inner my-2">
      <img
        id="qr-image-tag"
        src={`https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=4&data=${encodeURIComponent(`http://localhost:4321/a/${slug}?pin=${pin}`)}`}
        alt={`Codigo QR para acceder a la boveda de ${title}`}
        class="h-36 w-36 sm:h-44 sm:w-44 object-contain rounded-lg"
      />
    </div>

    <div class="mt-2 text-center w-full">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-white/10 border border-white/10 text-xs font-mono text-gray-200">
        <span class="text-gray-400">PIN de acceso:</span>
        <span class="font-bold tracking-widest text-white">{pin}</span>
      </div>
    </div>
  </div>

</aside>

<!-- Controles discretos para operador / DJ (autocultables tras inactividad) -->
<div id="live-operator-controls" class="fixed bottom-6 left-6 z-40 flex items-center gap-2 p-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-white transition-opacity duration-500">
  
  <!-- Boton Play / Pausa -->
  <button
    id="btn-live-playpause"
    type="button"
    class="p-2.5 rounded-full hover:bg-white/10 active:scale-95 transition"
    title="Pausar o reanudar rotacion (Espacio)"
  >
    <svg id="icon-live-pause" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6" />
    </svg>
    <svg id="icon-live-play" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
    </svg>
  </button>

  <!-- Boton Anterior -->
  <button
    id="btn-live-prev"
    type="button"
    class="p-2.5 rounded-full hover:bg-white/10 active:scale-95 transition"
    title="Recuerdo anterior (Flecha Izquierda)"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Boton Siguiente -->
  <button
    id="btn-live-next"
    type="button"
    class="p-2.5 rounded-full hover:bg-white/10 active:scale-95 transition"
    title="Recuerdo siguiente (Flecha Derecha)"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Boton Alternar QR -->
  <button
    id="btn-live-qr-visibility"
    type="button"
    class="p-2.5 rounded-full hover:bg-white/10 active:scale-95 transition text-gray-300 hover:text-white"
    title="Ocultar o mostrar tarjeta QR (Q)"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
    </svg>
  </button>

  <!-- Boton Pantalla Completa -->
  <button
    id="btn-live-fullscreen"
    type="button"
    class="p-2.5 rounded-full hover:bg-white/10 active:scale-95 transition"
    title="Pantalla completa (F)"
  >
    <svg id="icon-enter-fullscreen" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
    </svg>
    <svg id="icon-exit-fullscreen" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

</div>

<script define:vars={{ slug, pin }}>
  // Ajuste dinamico de URL del QR con el origen del navegador actual
  const qrImage = document.getElementById('qr-image-tag');
  if (qrImage) {
    const currentOrigin = window.location.origin;
    const targetUrl = `${currentOrigin}/a/${slug}?pin=${pin}`;
    qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=4&data=${encodeURIComponent(targetUrl)}`;
  }

  // Minimizacion de la tarjeta QR
  const qrCard = document.getElementById('live-qr-card');
  const qrContent = document.getElementById('live-qr-content');
  const btnToggleQr = document.getElementById('btn-toggle-qr');
  const btnQrVisibility = document.getElementById('btn-live-qr-visibility');
  let isQrMinimized = false;
  let isQrHidden = false;

  btnToggleQr?.addEventListener('click', () => {
    isQrMinimized = !isQrMinimized;
    if (isQrMinimized) {
      qrContent.classList.add('hidden');
    } else {
      qrContent.classList.remove('hidden');
    }
  });

  btnQrVisibility?.addEventListener('click', () => {
    isQrHidden = !isQrHidden;
    if (isQrHidden) {
      qrCard.classList.add('opacity-0', 'pointer-events-none');
    } else {
      qrCard.classList.remove('opacity-0', 'pointer-events-none');
    }
  });

  // Pantalla Completa
  const btnFullscreen = document.getElementById('btn-live-fullscreen');
  const iconEnterFullscreen = document.getElementById('icon-enter-fullscreen');
  const iconExitFullscreen = document.getElementById('icon-exit-fullscreen');

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

  btnFullscreen?.addEventListener('click', toggleFullscreen);

  document.addEventListener('fullscreenchange', () => {
    if (document.fullscreenElement) {
      iconEnterFullscreen?.classList.add('hidden');
      iconExitFullscreen?.classList.remove('hidden');
    } else {
      iconEnterFullscreen?.classList.remove('hidden');
      iconExitFullscreen?.classList.add('hidden');
    }
  });

  // Autocultar controles de operador tras 3 segundos de inactividad
  const controls = document.getElementById('live-operator-controls');
  const header = document.getElementById('live-header');
  let idleTimer = null;

  function resetIdleTimer() {
    if (controls) controls.style.opacity = '1';
    if (header) header.style.opacity = '1';
    document.body.style.cursor = 'default';

    clearTimeout(idleTimer);
    idleTimer = setTimeout(() => {
      if (controls) controls.style.opacity = '0';
      if (header) header.style.opacity = '0';
      document.body.style.cursor = 'none';
    }, 3500);
  }

  window.addEventListener('mousemove', resetIdleTimer);
  window.addEventListener('keydown', resetIdleTimer);
  resetIdleTimer();
</script>
