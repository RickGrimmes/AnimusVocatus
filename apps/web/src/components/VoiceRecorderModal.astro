---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<!-- Modal de Grabacion de Notas de Voz -->
<div
  id="voice-recorder-modal"
  data-slug={slug}
  class="fixed inset-0 z-50 hidden bg-black/85 p-4 backdrop-blur-md flex items-center justify-center"
>
  <div class="w-full max-w-sm rounded-3xl border border-white/10 bg-[#16181d] p-6 text-center shadow-2xl text-white">
    
    <!-- Encabezado -->
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <div class="text-left">
        <span class="text-[10px] font-semibold tracking-widest text-gray-400 uppercase">Audio</span>
        <h3 class="text-sm font-bold text-white">Nota de Voz para los Novios</h3>
      </div>
      <button id="close-voice-modal-btn" type="button" class="rounded-full p-1 text-gray-400 hover:text-white">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Area Central de Grabacion / Ondas -->
    <div class="my-6 flex flex-col items-center justify-center">
      
      <!-- Contador de tiempo -->
      <div id="voice-timer" class="text-2xl font-mono font-bold tracking-wider text-white">
        00:00
      </div>
      <span id="voice-status-label" class="mt-1 text-xs text-gray-400">
        Toca el micrófono para comenzar
      </span>

      <!-- Animador de Ondas de Audio -->
      <div id="waveform-container" class="mt-5 flex h-14 items-center justify-center gap-1.5 px-4">
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
        <span class="wave-bar h-2 w-1.5 rounded-full bg-white/20 transition-all duration-150"></span>
      </div>

      <!-- Reproductor previo (cuando la grabacion concluye) -->
      <div id="preview-audio-wrapper" class="mt-4 hidden w-full">
        <audio id="audio-preview" controls class="w-full h-10 rounded-xl bg-white/5"></audio>
      </div>

      <!-- Alerta de error -->
      <div id="voice-error-alert" class="mt-3 hidden rounded-xl bg-red-950/60 border border-red-500/40 p-2.5 text-xs text-red-300"></div>

    </div>

    <!-- Controles Inferiores -->
    <div class="flex items-center justify-center gap-3">
      
      <!-- Boton de Grabar / Detener -->
      <button
        type="button"
        id="btn-toggle-record"
        class="flex h-16 w-16 items-center justify-center rounded-full bg-red-600 text-white shadow-2xl transition active:scale-95 hover:bg-red-500"
        aria-label="Grabar audio"
      >
        <svg id="mic-icon" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
        </svg>
        <svg id="stop-icon" class="h-6 w-6 hidden" fill="currentColor" viewBox="0 0 24 24">
          <rect x="6" y="6" width="12" height="12" rx="2" />
        </svg>
      </button>

      <!-- Boton de Enviar Audio a Cloudflare R2 -->
      <button
        type="button"
        id="btn-send-audio"
        class="hidden flex-1 rounded-2xl bg-white py-3.5 text-xs font-bold tracking-wider text-black uppercase transition active:scale-95 hover:bg-gray-200"
      >
        Enviar Nota de Voz
      </button>

      <!-- Boton de Descartar / Grabar de nuevo -->
      <button
        type="button"
        id="btn-discard-audio"
        class="hidden rounded-2xl border border-white/10 bg-white/5 px-4 py-3.5 text-xs text-gray-400 hover:text-white"
        aria-label="Descartar y volver a grabar"
      >
        Descartar
      </button>

    </div>

  </div>
</div>

<script>
  const voiceModal = document.getElementById('voice-recorder-modal');
  const slug = voiceModal?.getAttribute('data-slug') || 'boda-carlos-y-sofia';

  const closeBtn = document.getElementById('close-voice-modal-btn');
  const toggleRecordBtn = document.getElementById('btn-toggle-record');
  const micIcon = document.getElementById('mic-icon');
  const stopIcon = document.getElementById('stop-icon');
  const sendBtn = document.getElementById('btn-send-audio') as HTMLButtonElement | null;
  const discardBtn = document.getElementById('btn-discard-audio');

  const voiceTimer = document.getElementById('voice-timer');
  const voiceStatusLabel = document.getElementById('voice-status-label');
  const previewWrapper = document.getElementById('preview-audio-wrapper');
  const audioPreview = document.getElementById('audio-preview') as HTMLAudioElement | null;
  const voiceError = document.getElementById('voice-error-alert');
  const waveBars = document.querySelectorAll('.wave-bar');

  let mediaRecorder: MediaRecorder | null = null;
  let audioChunks: Blob[] = [];
  let audioBlob: Blob | null = null;
  let timerInterval: ReturnType<typeof setInterval> | null = null;
  let recordSeconds = 0;
  let audioStream: MediaStream | null = null;
  let waveAnimInterval: ReturnType<typeof setInterval> | null = null;

  closeBtn?.addEventListener('click', () => {
    stopAndReset();
    voiceModal?.classList.add('hidden');
  });

  discardBtn?.addEventListener('click', () => {
    stopAndReset();
    resetUI();
  });

  function resetUI() {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
    recordSeconds = 0;
    if (voiceTimer) voiceTimer.textContent = '00:00 / 00:30';
    if (voiceStatusLabel) voiceStatusLabel.textContent = 'Toca el micrófono para comenzar';
    previewWrapper?.classList.add('hidden');
    toggleRecordBtn?.classList.remove('hidden');
    sendBtn?.classList.add('hidden');
    discardBtn?.classList.add('hidden');
    micIcon?.classList.remove('hidden');
    stopIcon?.classList.add('hidden');
    voiceError?.classList.add('hidden');
    stopWaveAnimation();
  }

  function stopAndReset() {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }
    if (audioStream) {
      audioStream.getTracks().forEach((track) => track.stop());
      audioStream = null;
    }
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
    if (waveAnimInterval) clearInterval(waveAnimInterval);
  }

  function startWaveAnimation() {
    waveAnimInterval = setInterval(() => {
      waveBars.forEach((bar) => {
        const height = Math.floor(Math.random() * 40) + 8;
        (bar as HTMLElement).style.height = `${height}px`;
        (bar as HTMLElement).classList.remove('bg-white/20');
        (bar as HTMLElement).classList.add('bg-red-500');
      });
    }, 120);
  }

  function stopWaveAnimation() {
    if (waveAnimInterval) clearInterval(waveAnimInterval);
    waveBars.forEach((bar) => {
      (bar as HTMLElement).style.height = '8px';
      (bar as HTMLElement).classList.add('bg-white/20');
      (bar as HTMLElement).classList.remove('bg-red-500');
    });
  }

  toggleRecordBtn?.addEventListener('click', async () => {
    if (!mediaRecorder || mediaRecorder.state === 'inactive') {
      // Iniciar grabacion
      try {
        voiceError?.classList.add('hidden');
        audioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        
        // Formato soportado por navegador
        const mimeType = MediaRecorder.isTypeSupported('audio/webm')
          ? 'audio/webm'
          : MediaRecorder.isTypeSupported('audio/mp4')
            ? 'audio/mp4'
            : '';

        mediaRecorder = mimeType ? new MediaRecorder(audioStream, { mimeType }) : new MediaRecorder(audioStream);
        audioChunks = [];

        mediaRecorder.ondataavailable = (e) => {
          if (e.data.size > 0) audioChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
          }
          if (audioStream) {
            audioStream.getTracks().forEach((track) => track.stop());
            audioStream = null;
          }

          const type = mediaRecorder?.mimeType || 'audio/webm';
          audioBlob = new Blob(audioChunks, { type });
          if (audioPreview && audioBlob) {
            audioPreview.src = URL.createObjectURL(audioBlob);
          }

          const finalSecs = String(Math.min(recordSeconds, 30)).padStart(2, '0');
          if (voiceTimer) voiceTimer.textContent = `00:${finalSecs} / 00:30`;

          previewWrapper?.classList.remove('hidden');
          toggleRecordBtn?.classList.add('hidden');
          sendBtn?.classList.remove('hidden');
          discardBtn?.classList.remove('hidden');
          stopWaveAnimation();
          if (voiceStatusLabel) voiceStatusLabel.textContent = 'Escucha tu mensaje antes de enviar';
        };

        mediaRecorder.start();
        recordSeconds = 0;
        const startTime = Date.now();
        if (timerInterval) clearInterval(timerInterval);

        timerInterval = setInterval(() => {
          const elapsed = Math.floor((Date.now() - startTime) / 1000);
          recordSeconds = elapsed;
          const capped = Math.min(recordSeconds, 30);
          const secs = String(capped).padStart(2, '0');
          if (voiceTimer) voiceTimer.textContent = `00:${secs} / 00:30`;

          // Limite maximo estricto de 30 segundos
          if (recordSeconds >= 30) {
            if (timerInterval) {
              clearInterval(timerInterval);
              timerInterval = null;
            }
            if (mediaRecorder?.state === 'recording') {
              mediaRecorder.stop();
            }
          }
        }, 200);

        micIcon?.classList.add('hidden');
        stopIcon?.classList.remove('hidden');
        if (voiceStatusLabel) voiceStatusLabel.textContent = 'Grabando... toca el botón para terminar (máx 30s)';
        startWaveAnimation();

      } catch (err: any) {
        console.error('Error de microfono:', err);
        if (voiceError) {
          voiceError.textContent = 'Permiso de micrófono denegado o no disponible en este dispositivo.';
          voiceError.classList.remove('hidden');
        }
      }
    } else if (mediaRecorder.state === 'recording') {
      // Detener grabacion
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
      mediaRecorder.stop();
      if (audioStream) {
        audioStream.getTracks().forEach((t) => t.stop());
        audioStream = null;
      }
    }
  });

  // Sincronizar tiempo de reproduccion de vista previa
  audioPreview?.addEventListener('loadedmetadata', () => {
    if (audioPreview.duration && isFinite(audioPreview.duration)) {
      const dur = Math.round(audioPreview.duration);
      const secsStr = String(Math.min(dur, 30)).padStart(2, '0');
      if (voiceTimer) voiceTimer.textContent = `00:${secsStr} / 00:30`;
    }
  });

  audioPreview?.addEventListener('timeupdate', () => {
    if (!audioPreview.duration || !isFinite(audioPreview.duration)) return;
    const curr = String(Math.floor(audioPreview.currentTime)).padStart(2, '0');
    const total = String(Math.min(Math.round(audioPreview.duration), 30)).padStart(2, '0');
    if (voiceTimer) voiceTimer.textContent = `00:${curr} / 00:${total}`;
  });

  audioPreview?.addEventListener('ended', () => {
    const total = String(Math.min(Math.round(audioPreview.duration || recordSeconds), 30)).padStart(2, '0');
    if (voiceTimer) voiceTimer.textContent = `00:${total} / 00:30`;
  });

  // Enviar audio a Cloudflare R2
  sendBtn?.addEventListener('click', async () => {
    if (!audioBlob) return;

    const token = localStorage.getItem(`animus_token_${slug}`);
    if (!token || token.startsWith('demo-')) {
      const pinGate = document.getElementById('pin-gate');
      pinGate?.classList.remove('hidden');
      return;
    }

    const author = localStorage.getItem('animus_guest_author') || 'Invitado';
    const cleanMime = (audioBlob.type || 'audio/webm').split(';')[0].trim().toLowerCase();
    const ext = cleanMime.includes('mp4') ? 'm4a' : 'webm';
    const filename = `nota_de_voz_${Date.now()}.${ext}`;

    try {
      if (sendBtn) {
        sendBtn.disabled = true;
        sendBtn.textContent = 'Guardando en la bóveda...';
      }

      // 1. Solicitar enlace seguro
      const presignedRes = await fetch(`http://localhost:8000/api/a/${slug}/batch-presigned`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          files: [
            {
              filename,
              size_bytes: audioBlob.size,
              content_type: cleanMime,
            },
          ],
        }),
      });

      if (!presignedRes.ok) {
        throw new Error('No fue posible preparar el espacio para guardar la nota de voz');
      }

      const { items } = await presignedRes.json();
      const item = items[0];

      // 2. Subir directamente a Cloudflare R2 via HTTP PUT con Cache-Control
      await fetch(item.upload_url, {
        method: 'PUT',
        headers: {
          'Content-Type': cleanMime,
          'Cache-Control': 'public, max-age=31536000, immutable',
        },
        body: audioBlob,
      });

      // 3. Confirmar en base de datos
      await fetch(`http://localhost:8000/api/a/${slug}/media/confirm`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          id: item.file_id,
          r2_key: item.r2_key,
          thumb_r2_key: null,
          filename,
          content_type: cleanMime,
          size_bytes: audioBlob.size,
          guest_author: author,
        }),
      });

      if (sendBtn) sendBtn.textContent = 'Enviada con éxito';

      if (typeof (window as any).showInAppToast === 'function') {
        (window as any).showInAppToast('Nota de voz guardada con éxito en la bóveda', 'success');
      }

      // Notificar al feed y cerrar
      window.dispatchEvent(new CustomEvent('animus-media-uploaded'));
      setTimeout(() => {
        voiceModal?.classList.add('hidden');
        resetUI();
        if (sendBtn) {
          sendBtn.disabled = false;
          sendBtn.textContent = 'Enviar Nota de Voz';
        }
      }, 800);

    } catch (err: any) {
      console.error('Detalle al subir nota de voz:', err);
      if (typeof (window as any).showInAppToast === 'function') {
        (window as any).showInAppToast(err.message || 'No fue posible guardar la nota de voz', 'error');
      } else if (voiceError) {
        voiceError.textContent = err.message || 'Error al enviar audio.';
        voiceError.classList.remove('hidden');
      }
      if (sendBtn) {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Reintentar Enviar';
      }
    }
  });

  // Escuchar evento para abrir grabadora desde la seccion de Voces
  window.addEventListener('open-voice-recorder', () => {
    resetUI();
    voiceModal?.classList.remove('hidden');
  });
</script>
