---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div id="gallery-container" class="pb-24">
  
  <!-- Encabezado estilo Galeria Nativa de Telefono -->
  <div class="sticky top-0 z-20 flex items-center justify-between border-b border-white/10 bg-[#14161b]/95 px-4 py-3.5 backdrop-blur-md">
    <div>
      <h2 id="gallery-counter" class="text-sm font-bold text-white">Cargando galeria...</h2>
    </div>
  </div>

  <!-- Cuadricula 3 columnas estilo galeria de fotos de telefono -->
  <div id="gallery-grid" class="grid grid-cols-3 gap-0.5 sm:gap-1">
    <!-- Rellenado dinamicamente con JavaScript -->
  </div>

  <!-- Estado vacio si aun no hay fotos -->
  <div id="gallery-empty" class="hidden py-24 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/5 text-gray-500">
      <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
    <h3 class="mt-4 text-sm font-bold text-white">La boveda esta vacia</h3>
    <p class="mt-1 text-xs text-gray-500">Se el primero de tu mesa en subir una foto o video.</p>
  </div>

</div>

<script define:vars={{ slug }}>
  let mediaList = [];
  const grid = document.getElementById('gallery-grid');
  const counter = document.getElementById('gallery-counter');
  const emptyState = document.getElementById('gallery-empty');
  const playReelsBtn = document.getElementById('btn-play-reels');

  // Datos mock de demostracion si la API aun no tiene fotos subidas
  const DEMO_MEDIA = [
    {
      id: 'demo-1',
      filename: 'ceremonia.jpg',
      content_type: 'image/jpeg',
      guest_author: 'Carlos M.',
      created_at: 'hace 5 min',
      url: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=1200&auto=format&fit=crop&q=80',
      thumb_url: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=400&auto=format&fit=crop&q=80',
    },
    {
      id: 'demo-2',
      filename: 'novios_brindis.jpg',
      content_type: 'image/jpeg',
      guest_author: 'Sofia G.',
      created_at: 'hace 12 min',
      url: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=1200&auto=format&fit=crop&q=80',
      thumb_url: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=400&auto=format&fit=crop&q=80',
    },
    {
      id: 'demo-3',
      filename: 'baile.jpg',
      content_type: 'image/jpeg',
      guest_author: 'Tia Carmen',
      created_at: 'hace 20 min',
      url: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=1200&auto=format&fit=crop&q=80',
      thumb_url: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=400&auto=format&fit=crop&q=80',
    },
    {
      id: 'demo-4',
      filename: 'recepcion.jpg',
      content_type: 'image/jpeg',
      guest_author: 'Alejandro',
      created_at: 'hace 35 min',
      url: 'https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=1200&auto=format&fit=crop&q=80',
      thumb_url: 'https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=400&auto=format&fit=crop&q=80',
    },
    {
      id: 'demo-5',
      filename: 'anillos.jpg',
      content_type: 'image/jpeg',
      guest_author: 'Familia Morales',
      created_at: 'hace 40 min',
      url: 'https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?w=1200&auto=format&fit=crop&q=80',
      thumb_url: 'https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?w=400&auto=format&fit=crop&q=80',
    },
    {
      id: 'demo-6',
      filename: 'pastel.jpg',
      content_type: 'image/jpeg',
      guest_author: 'Roberto',
      created_at: 'hace 1 hora',
      url: 'https://images.unsplash.com/photo-1535295972055-1c762f4483e5?w=1200&auto=format&fit=crop&q=80',
      thumb_url: 'https://images.unsplash.com/photo-1535295972055-1c762f4483e5?w=400&auto=format&fit=crop&q=80',
    },
  ];

  async function loadFeed() {
    try {
      const res = await fetch(`http://localhost:8000/api/a/${slug}/feed`);
      if (res.ok) {
        const data = await res.json();
        mediaList = data.length > 0 ? data : DEMO_MEDIA;
      } else {
        mediaList = DEMO_MEDIA;
      }
    } catch {
      mediaList = DEMO_MEDIA;
    }
    renderGrid();
  }

  function renderGrid() {
    grid.innerHTML = '';
    if (mediaList.length === 0) {
      emptyState.classList.remove('hidden');
      counter.textContent = '0 recuerdos';
      return;
    }

    emptyState.classList.add('hidden');
    counter.textContent = `${mediaList.length} ${mediaList.length === 1 ? 'recuerdo' : 'recuerdos'}`;

    mediaList.forEach((item, index) => {
      const cell = document.createElement('div');
      cell.className = 'relative aspect-square cursor-pointer overflow-hidden bg-white/5 active:opacity-75';

      const fallbackUrl = DEMO_MEDIA[index % DEMO_MEDIA.length]?.thumb_url || DEMO_MEDIA[0].thumb_url;
      const imgSrc = (item.thumb_url && !item.thumb_url.includes('mock-r2.local'))
        ? item.thumb_url
        : (item.url && !item.url.includes('mock-r2.local'))
          ? item.url
          : fallbackUrl;

      const isVideo = item.content_type && item.content_type.startsWith('video/');

      cell.innerHTML = `
        <img src="${imgSrc}" alt="${item.filename}" loading="lazy" onerror="this.src='${fallbackUrl}'" class="h-full w-full object-cover transition duration-300 hover:scale-105" />
        ${
          isVideo
            ? `<div class="absolute right-1.5 top-1.5 rounded-full bg-black/60 p-1 text-white backdrop-blur-sm">
                <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
               </div>`
            : ''
        }
      `;

      cell.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-reels-viewer', { detail: { mediaList, startIndex: index } }));
      });

      grid.appendChild(cell);
    });
  }

  playReelsBtn?.addEventListener('click', () => {
    if (mediaList.length > 0) {
      window.dispatchEvent(new CustomEvent('open-reels-viewer', { detail: { mediaList, startIndex: 0 } }));
    }
  });

  // Escuchar cuando el usuario se autentica o cuando sube fotos nuevas
  window.addEventListener('animus-authenticated', loadFeed);
  window.addEventListener('animus-media-uploaded', loadFeed);

  loadFeed();
</script>
