<script define:vars={{ targetIsoDate: coupleNames.targetIsoDate }}>
  // Animación de aparición suave conforme bajas (espera a que bajes más para lucir frente a tus ojos)
  const revealElements = document.querySelectorAll('.inv-reveal');
  if ('IntersectionObserver' in window) {
    // El encabezado principal aparece al instante al abrir la invitación
    const heroHeader = document.querySelector('header.inv-reveal');
    if (heroHeader) {
      requestAnimationFrame(() => heroHeader.classList.add('is-visible'));
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.28,
        rootMargin: '0px 0px -18% 0px',
      }
    );

    revealElements.forEach((el) => {
      if (el !== heroHeader) {
        revealObserver.observe(el);
      }
    });
  } else {
    revealElements.forEach((el) => el.classList.add('is-visible'));
  }

  // Animación de difuminado suave entre las 3 fotos principales de portada
  const heroSlidesEls = document.querySelectorAll('.hero-crossfade-slide');
  if (heroSlidesEls.length > 1) {
    let currentHeroIndex = 0;
    setInterval(() => {
      const prevEl = heroSlidesEls[currentHeroIndex];
      currentHeroIndex = (currentHeroIndex + 1) % heroSlidesEls.length;
      const nextEl = heroSlidesEls[currentHeroIndex];

      if (prevEl) {
        prevEl.classList.remove('opacity-100', 'scale-100', 'z-10');
        prevEl.classList.add('opacity-0', 'scale-105', 'z-0');
      }
      if (nextEl) {
        nextEl.classList.remove('opacity-0', 'scale-105', 'z-0');
        nextEl.classList.add('opacity-100', 'scale-100', 'z-10');
      }
    }, 4500);
  }

  // Mostrar / ocultar opciones de calendario y descargar archivo .ics para iPhone / Calendario nativo
  const btnToggleCal = document.getElementById('btn-toggle-calendar');
  const calPanel = document.getElementById('calendar-options-panel');
  const btnDownloadIcs = document.getElementById('btn-download-ics');

  btnToggleCal?.addEventListener('click', () => {
    if (!calPanel) return;
    if (calPanel.classList.contains('hidden')) {
      calPanel.classList.remove('hidden');
      calPanel.classList.add('grid');
    } else {
      calPanel.classList.add('hidden');
      calPanel.classList.remove('grid');
    }
  });

  btnDownloadIcs?.addEventListener('click', () => {
    const icsContent = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Ricardo y Kiara//Invitacion de Boda//ES',
      'CALSCALE:GREGORIAN',
      'METHOD:PUBLISH',
      'BEGIN:VEVENT',
      'UID:boda-ricardo-y-kiara-2027@invitacion',
      'SUMMARY:Boda de Ricardo & Kiara',
      'DTSTART:20270402T170000',
      'DTEND:20270403T020000',
      'LOCATION:Parroquia de San Pedro Apóstol, Calzada Mónaco 485, Torreón, Coahuila',
      'DESCRIPTION:Ceremonia Religiosa (17:00 hrs): Parroquia de San Pedro Apóstol. Recepción (19:00 hrs): Centro de Convenciones San Ángel, Torreón.',
      'STATUS:CONFIRMED',
      'BEGIN:VALARM',
      'TRIGGER:-P1D',
      'ACTION:DISPLAY',
      'DESCRIPTION:Mañana es la Boda de Ricardo & Kiara',
      'END:VALARM',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');

    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', 'boda-ricardo-y-kiara.ics');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    if (window.showInAppToast) {
      window.showInAppToast('Evento listo para guardar en tu calendario', 'success');
    }
  });

  // Copiar CLABE al portapapeles
  document.getElementById('btn-copy-clabe')?.addEventListener('click', () => {
    const clabe = '012180015482910294';
    if (navigator.clipboard) {
      navigator.clipboard.writeText(clabe).then(() => {
        if (window.showInAppToast) {
          window.showInAppToast('CLABE copiada al portapapeles con éxito', 'success');
        } else {
          alert('CLABE copiada al portapapeles');
        }
      }).catch(() => {
        if (window.showInAppToast) {
          window.showInAppToast('No se pudo copiar automáticamente', 'error');
        }
      });
    }
  });

  // Cuenta regresiva precisa
  function updateCountdown() {
    const target = new Date(targetIsoDate).getTime();
    const now = new Date().getTime();
    const diff = target - now;

    if (diff <= 0) {
      const elD = document.getElementById('cd-days');
      const elH = document.getElementById('cd-hours');
      const elM = document.getElementById('cd-minutes');
      const elS = document.getElementById('cd-seconds');
      if (elD) elD.textContent = '00';
      if (elH) elH.textContent = '00';
      if (elM) elM.textContent = '00';
      if (elS) elS.textContent = '00';
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    const pad = (n) => String(n).padStart(2, '0');
    const elD = document.getElementById('cd-days');
    const elH = document.getElementById('cd-hours');
    const elM = document.getElementById('cd-minutes');
    const elS = document.getElementById('cd-seconds');
    if (elD) elD.textContent = pad(days);
    if (elH) elH.textContent = pad(hours);
    if (elM) elM.textContent = pad(minutes);
    if (elS) elS.textContent = pad(seconds);
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
