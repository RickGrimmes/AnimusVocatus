---
import Layout from '../../layouts/Layout.astro';
import MusicPlayerWidget from '../../components/MusicPlayerWidget.astro';
import CoupleGallery from '../../components/CoupleGallery.astro';
import { fetchEventVocatus } from '../../lib/api';

export function getStaticPaths() {
  return [
    { params: { slug: 'boda-carlos-y-sofia' } },
    { params: { slug: 'boda-ricardo-y-kiara' } },
  ];
}

const { slug } = Astro.params;
const currentSlug = slug || 'boda-carlos-y-sofia';
const event = await fetchEventVocatus(currentSlug);

const isRicardoKiara = currentSlug === 'boda-ricardo-y-kiara';

const coupleNames = isRicardoKiara
  ? {
      groom: 'MARTÍN RICARDO CABELLO RODRÍGUEZ',
      bride: 'KIARA DELGADILLO TORRES',
      shortTitle: 'Ricardo & Kiara',
      formalDate: 'Viernes, 2 de Abril de 2027',
      targetIsoDate: '2027-04-02T17:00:00',
    }
  : {
      groom: 'CARLOS MORALES',
      bride: 'SOFÍA GARZA',
      shortTitle: event.title,
      formalDate: 'Domingo, 25 de Octubre de 2026',
      targetIsoDate: event.event_date || '2026-10-25T18:00:00',
    };

// Mensaje predeterminado para WhatsApp
const waText = encodeURIComponent(
  `Hola ${coupleNames.shortTitle}, confirmo con mucho gusto mi asistencia a su boda.`
);
const waPhone = '528112345678';
const waUrl = `https://wa.me/${waPhone}?text=${waText}`;

// Enlace directo a Google Calendar (Viernes 2 de Abril de 2027, 17:00 hrs a 02:00 hrs)
const gcalTitle = encodeURIComponent(`Boda de ${coupleNames.shortTitle}`);
const gcalDetails = encodeURIComponent(
  `Ceremonia Religiosa (17:00 hrs): Parroquia de San Pedro Apóstol, Calzada Mónaco 485, Torreón.\nRecepción (19:00 hrs): Centro de Convenciones San Ángel, Av. Lerdo de Tejada, Torreón.`
);
const gcalLocation = encodeURIComponent('Parroquia de San Pedro Apóstol, Calzada Mónaco 485, Torreón, Coahuila');
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${gcalTitle}&dates=20270402T170000/20270403T020000&details=${gcalDetails}&location=${gcalLocation}&ctz=America/Monterrey`;

// Fotografías principales de portada (3 fotos con difuminado automático)
// Para usar tus propias fotos, guárdalas en: apps/web/public/images/
// y cambia estas rutas por '/images/portada-1.jpg', '/images/portada-2.jpg', '/images/portada-3.jpg'
const heroSlides = [
  {
    src: 'https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=85',
    alt: 'Ricardo y Kiara — Portada 1',
  },
  {
    src: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=85',
    alt: 'Ricardo y Kiara — Portada 2',
  },
  {
    src: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=85',
    alt: 'Ricardo y Kiara — Portada 3',
  },
];

// Itinerario
const itineraryList = isRicardoKiara
  ? [
      { time: '16:30 hrs', title: 'Llegada de Invitados', desc: 'Recepción y bienvenida en la parroquia' },
      { time: '17:00 hrs', title: 'Ceremonia Religiosa', desc: 'Solemne misa de matrimonio' },
      { time: '19:00 hrs', title: 'Cóctel de Bienvenida', desc: 'Música en vivo y brindis de honor' },
      { time: '20:30 hrs', title: 'Banquete & Cena', desc: 'Cena formal de cuatro tiempos' },
      { time: '22:30 hrs', title: 'Apertura de Pista', desc: 'Vals nupcial y celebración con los novios' },
    ]
  : [
      { time: '18:00 hrs', title: 'Ceremonia Religiosa', desc: 'Capilla Principal' },
      { time: '19:30 hrs', title: 'Cóctel de Bienvenida', desc: 'Jardín Central' },
      { time: '21:00 hrs', title: 'Recepción y Cena', desc: 'Salón Principal' },
      { time: '23:00 hrs', title: 'Fiesta', desc: 'Celebración' },
    ];
---

<Layout title={`${coupleNames.shortTitle} — Invitación de Boda`} theme="editorial">

  <!-- Contenedor centralizado para la invitación -->
  <main class="mx-auto max-w-lg pb-20">
    
    <!-- Portada Fotográfica con Transición Suave (3 Fotos + Difuminado Inferior) -->
    <div class="relative h-[460px] sm:h-[520px] w-full overflow-hidden bg-editorial-bg">
      {heroSlides.map((slide, index) => (
        <img
          src={slide.src}
          alt={slide.alt}
          data-hero-slide={index}
          class:list={[
            'hero-crossfade-slide absolute inset-0 h-full w-full object-cover object-center transition-all duration-[1800ms] ease-in-out will-change-[opacity,transform]',
            index === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0',
          ]}
        />
      ))}

      <!-- Sutil velo superior para profundidad -->
      <div class="pointer-events-none absolute inset-x-0 top-0 z-20 h-20 bg-gradient-to-b from-black/15 to-transparent"></div>

      <!-- Difuminado inferior blanco/crema que conecta con el texto de abajo -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-44 bg-gradient-to-t from-[#fcfbf9] via-[#fcfbf9]/85 to-transparent"></div>
    </div>

    <div class="px-5">
    <!-- Hero Editorial de Alta Gama -->
    <header class="inv-reveal relative z-30 -mt-8 text-center">
      <span class="text-xs sm:text-sm font-semibold tracking-[0.35em] text-gray-500 uppercase">
        Nuestra Boda
      </span>

      <!-- Nombres de los Novios -->
      <div class="mt-6 space-y-2.5">
        <h1 class="font-serif text-3xl font-normal tracking-wide text-gray-950 uppercase sm:text-4xl leading-snug">
          {coupleNames.groom}
        </h1>
        <div class="flex items-center justify-center gap-3 py-1.5">
          <div class="inv-line-grow h-px w-14 bg-gray-300"></div>
          <span class="font-serif text-2xl italic text-gray-400">&</span>
          <div class="inv-line-grow h-px w-14 bg-gray-300"></div>
        </div>
        <h2 class="font-serif text-3xl font-normal tracking-wide text-gray-950 uppercase sm:text-4xl leading-snug">
          {coupleNames.bride}
        </h2>
      </div>

      <!-- Fecha formal -->
      <p class="mt-7 font-serif text-xl sm:text-2xl italic text-gray-800">
        {coupleNames.formalDate}
      </p>

      <!-- Mensaje de honor -->
      <div class="mx-auto mt-7 max-w-md border-t border-b border-gray-200/90 py-6 px-2">
        <p class="font-serif text-lg sm:text-xl leading-relaxed text-gray-700 italic">
          "Con la bendición de Dios y de nuestras familias, tenemos el honor de invitarte a celebrar con nosotros el inicio de nuestro matrimonio."
        </p>
      </div>
    </header>

    <!-- Cuenta Regresiva de Alto Impacto + Agendar en Calendario -->
    <section class="inv-reveal mt-10 relative overflow-hidden rounded-3xl bg-[#141416] p-1.5 shadow-xl ring-1 ring-black/10">
      <!-- Fotografía sutil de fondo con velo oscuro y destello cálido -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-3xl">
        <img
          src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=900&q=80"
          alt=""
          class="h-full w-full object-cover opacity-20 scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#141416]/90 via-[#141416]/85 to-[#141416]/95"></div>
      </div>

      <!-- Marco interior con borde champaña/dorado -->
      <div class="relative z-10 rounded-[20px] border border-amber-200/25 px-5 py-8 text-center">
        
        <div class="flex items-center justify-center gap-3">
          <div class="inv-line-grow h-px w-10 bg-amber-200/40"></div>
          <span class="text-xs font-semibold tracking-[0.35em] text-amber-200/90 uppercase">
            Reserva la Fecha
          </span>
          <div class="inv-line-grow h-px w-10 bg-amber-200/40"></div>
        </div>

        <h3 class="mt-2 font-serif text-2xl sm:text-3xl font-normal text-white">
          Faltan Sólo
        </h3>
        <p class="mt-1 font-serif text-sm sm:text-base italic text-white/70">
          Para el inicio de nuestro para siempre
        </p>

        <!-- Tarjetas de Tiempo con Efecto Cristal y Borde Dorado -->
        <div id="countdown-grid" class="mt-6 grid grid-cols-4 gap-2.5">
          <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-amber-200/20 bg-white/[0.07] py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 80ms;">
            <span id="cd-days" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-white">00</span>
            <span class="mt-1.5 text-[10px] font-semibold tracking-[0.2em] text-amber-200/80 uppercase">Días</span>
          </div>
          <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-amber-200/20 bg-white/[0.07] py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 160ms;">
            <span id="cd-hours" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-white">00</span>
            <span class="mt-1.5 text-[10px] font-semibold tracking-[0.2em] text-amber-200/80 uppercase">Horas</span>
          </div>
          <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-amber-200/20 bg-white/[0.07] py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 240ms;">
            <span id="cd-minutes" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-white">00</span>
            <span class="mt-1.5 text-[10px] font-semibold tracking-[0.2em] text-amber-200/80 uppercase">Min</span>
          </div>
          <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-amber-200/20 bg-white/[0.07] py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 320ms;">
            <span id="cd-seconds" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-amber-200">00</span>
            <span class="mt-1.5 text-[10px] font-semibold tracking-[0.2em] text-amber-200/80 uppercase">Seg</span>
          </div>
        </div>

        <!-- Botón de Calendario Destacado -->
        <div class="mt-7 pt-6 border-t border-white/10">
          <button
            id="btn-toggle-calendar"
            type="button"
            class="inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-[#e6d3b3] via-[#f3e5cc] to-[#e6d3b3] px-7 py-3.5 text-xs font-bold tracking-[0.2em] text-gray-950 uppercase shadow-md transition duration-300 hover:brightness-105 active:scale-95"
          >
            <svg class="h-4 w-4 text-gray-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Agendar en mi Calendario</span>
          </button>

          <!-- Opciones desplegables (Google Calendar / Apple & Celular) -->
          <div
            id="calendar-options-panel"
            class="hidden mt-3.5 grid-cols-2 gap-2.5 pt-1 transition-all duration-300"
          >
            <a
              href={googleCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 py-3 px-3 text-xs font-semibold text-white backdrop-blur-xs transition hover:bg-white/20 active:scale-95"
            >
              <svg class="h-4 w-4 text-amber-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Google Calendar</span>
            </a>
            <button
              id="btn-download-ics"
              type="button"
              class="flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 py-3 px-3 text-xs font-semibold text-white backdrop-blur-xs transition hover:bg-white/20 active:scale-95"
            >
              <svg class="h-4 w-4 text-amber-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
              <span>Apple / Celular</span>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Galería Editorial de Fotos -->
    <CoupleGallery />

    <!-- Separador Ornamental Editorial -->
    <div class="inv-reveal my-10 flex items-center justify-center gap-3 opacity-60">
      <div class="inv-line-grow h-px w-16 bg-gray-300"></div>
      <span class="h-1.5 w-1.5 rotate-45 bg-gray-400"></span>
      <div class="inv-line-grow h-px w-16 bg-gray-300"></div>
    </div>

    <!-- Ubicación: Iglesia (Ceremonia Religiosa) -->
    <section class="inv-reveal overflow-hidden rounded-2xl border border-gray-200/80 bg-white shadow-xs transition-shadow duration-500 hover:shadow-md">
      <!-- Fotografía del lugar (Puedes reemplazarla poniendo tu foto en public/images/iglesia.jpg) -->
      <div class="relative h-52 w-full overflow-hidden bg-gray-900">
        <img
          src="https://images.unsplash.com/photo-1548625361-195fe57724e3?auto=format&fit=crop&w=900&q=85"
          alt="Parroquia de San Pedro Apóstol"
          class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
        <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between">
          <div>
            <span class="block text-[10px] font-semibold tracking-[0.25em] text-white/80 uppercase">
              Ceremonia Religiosa
            </span>
            <h3 class="mt-0.5 font-serif text-xl font-normal text-white">
              Parroquia de San Pedro Apóstol
            </h3>
          </div>
          <span class="rounded-full bg-white/95 px-3 py-1 text-[11px] font-semibold text-gray-900 shadow-xs backdrop-blur-xs">
            17:00 hrs
          </span>
        </div>
      </div>

      <div class="p-6">
        <div class="flex items-start gap-2.5 text-gray-600">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p class="text-xs leading-relaxed text-gray-600">
            Calzada Mónaco 485, Residencial San Isidro, Torreón, Coahuila, C.P. 27100.
          </p>
        </div>

        <!-- Mini mapa interactivo de Google Maps -->
        <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-gray-50 shadow-2xs">
          <iframe
            title="Mapa Parroquia de San Pedro Apóstol"
            src="https://maps.google.com/maps?q=Parroquia+de+San+Pedro+Apostol+Torreon+25.5659072,-103.4318185&t=&z=16&ie=UTF8&iwloc=&output=embed"
            class="h-44 w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a
            href="https://maps.app.goo.gl/JTh9BtxJdsrYgC7s5"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between border-t border-gray-200/80 bg-gray-50/90 px-3.5 py-2.5 text-[11px] font-medium text-gray-600 transition hover:bg-gray-100"
          >
            <span>Ver ubicación exacta en Google Maps</span>
            <svg class="h-3.5 w-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <a
            href="https://maps.app.goo.gl/JTh9BtxJdsrYgC7s5"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl bg-gray-900 py-2.5 text-xs font-semibold text-white transition hover:bg-black active:scale-95"
          >
            <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
            </svg>
            <span>Google Maps</span>
          </a>
          <a
            href="https://waze.com/ul?ll=25.5659072,-103.4318185&navigate=yes"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl border border-gray-200 bg-gray-50 py-2.5 text-xs font-semibold text-gray-800 transition hover:bg-gray-100 active:scale-95"
          >
            <svg class="h-4 w-4 text-sky-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2a9 9 0 0 0-9 9c0 3.3 1.7 6.2 4.4 7.8-.1.5-.4 1.8-.5 2.2 0 0 0 .2.1.2.1 0 .3 0 .4-.1.7-.5 1.7-1.1 2.4-1.6.8.3 1.7.5 2.6.5 5 0 9-4 9-9s-4-9-9-9z" />
            </svg>
            <span>Abrir en Waze</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Ubicación: Recepción (Fiesta & Banquete) -->
    <section class="inv-reveal mt-8 overflow-hidden rounded-2xl border border-gray-200/80 bg-white shadow-xs transition-shadow duration-500 hover:shadow-md">
      <!-- Fotografía del lugar (Puedes reemplazarla poniendo tu foto en public/images/recepcion.jpg) -->
      <div class="relative h-52 w-full overflow-hidden bg-gray-900">
        <img
          src="https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=900&q=85"
          alt="Centro de Convenciones San Ángel"
          class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
        <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between">
          <div>
            <span class="block text-[10px] font-semibold tracking-[0.25em] text-white/80 uppercase">
              Recepción & Banquete
            </span>
            <h3 class="mt-0.5 font-serif text-xl font-normal text-white">
              Centro de Convenciones San Ángel
            </h3>
          </div>
          <span class="rounded-full bg-white/95 px-3 py-1 text-[11px] font-semibold text-gray-900 shadow-xs backdrop-blur-xs">
            19:00 hrs
          </span>
        </div>
      </div>

      <div class="p-6">
        <div class="flex items-start gap-2.5 text-gray-600">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p class="text-xs leading-relaxed text-gray-600">
            Av. Lerdo de Tejada, Centro, Torreón, Coahuila, C.P. 27100.
          </p>
        </div>

        <!-- Mini mapa interactivo de Google Maps -->
        <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-gray-50 shadow-2xs">
          <iframe
            title="Mapa Centro de Convenciones San Ángel"
            src="https://maps.google.com/maps?q=25.5546346,-103.4324767&t=&z=16&ie=UTF8&iwloc=&output=embed"
            class="h-44 w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a
            href="https://maps.app.goo.gl/YqPAXaNvbj2CnKM49"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between border-t border-gray-200/80 bg-gray-50/90 px-3.5 py-2.5 text-[11px] font-medium text-gray-600 transition hover:bg-gray-100"
          >
            <span>Ver ubicación exacta en Google Maps</span>
            <svg class="h-3.5 w-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <a
            href="https://maps.app.goo.gl/YqPAXaNvbj2CnKM49"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl bg-gray-900 py-2.5 text-xs font-semibold text-white transition hover:bg-black active:scale-95"
          >
            <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
            </svg>
            <span>Google Maps</span>
          </a>
          <a
            href="https://waze.com/ul?ll=25.5546346,-103.4324767&navigate=yes"
            target="_blank"
            rel="noopener noreferrer"
