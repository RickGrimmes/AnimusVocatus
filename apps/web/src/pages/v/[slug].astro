---
import Layout from '../../layouts/Layout.astro';
import RSVPModal from '../../components/RSVPModal.astro';
import { fetchEventVocatus, DEMO_VOCATUS_EVENT } from '../../lib/api';

export function getStaticPaths() {
  return [
    { params: { slug: 'boda-carlos-y-sofia' } },
  ];
}

const { slug } = Astro.params;
const event = await fetchEventVocatus(slug || 'boda-carlos-y-sofia');

const itineraryItems = event.itinerary
  ? event.itinerary.split('|').map((item) => item.trim())
  : ['18:00 Ceremonia Religiosa', '19:30 Coctel', '21:00 Recepcion'];
---

<Layout title={`${event.title} — Invitacion`} theme="editorial">
  
  <!-- Banner dinamico Time-Aware (Enlace a Animus Boveda) -->
  <aside class="sticky top-0 z-40 bg-black px-4 py-2.5 text-center text-xs font-semibold tracking-wider text-white uppercase">
    <a href={`/a/${event.slug}`} class="inline-flex items-center gap-2 hover:underline">
      <span>Boveda de fotos y recuerdos del evento</span>
      <span class="rounded bg-white/20 px-1.5 py-0.5 text-[10px]">Animus</span>
      <span>&rarr;</span>
    </a>
  </aside>

  <!-- Contenedor centralizado para emulacion movil y editorial -->
  <main class="mx-auto max-w-lg px-5 pt-8 pb-32">
    
    <!-- Hero Editorial -->
    <header class="text-center">
      <span class="text-xs font-semibold tracking-[0.3em] text-gray-500 uppercase">
        {event.event_type === 'boda' ? 'Nuestra Boda' : 'Invitacion Formal'}
      </span>
      <h1 class="mt-3 font-serif text-4xl font-normal tracking-tight text-gray-950 sm:text-5xl">
        {event.title}
      </h1>
      <div class="mx-auto mt-4 h-px w-16 bg-gray-300"></div>
      <p class="mt-4 font-serif text-lg italic text-gray-600">
        Tenemos el honor de invitarte a compartir este dia tan especial con nosotros.
      </p>
    </header>

    <!-- Cuenta Regresiva -->
    <section class="mt-10 rounded-2xl border border-gray-200/80 bg-white/60 p-6 text-center shadow-sm backdrop-blur-sm">
      <span class="text-[11px] font-semibold tracking-widest text-gray-400 uppercase">Cuenta Regresiva</span>
      <div id="countdown-grid" class="mt-4 grid grid-cols-4 gap-2">
        <div class="rounded-xl bg-gray-50 p-2.5">
          <span id="cd-days" class="font-serif text-2xl font-bold text-gray-900">00</span>
          <span class="block text-[10px] tracking-wider text-gray-500 uppercase">Dias</span>
        </div>
        <div class="rounded-xl bg-gray-50 p-2.5">
          <span id="cd-hours" class="font-serif text-2xl font-bold text-gray-900">00</span>
          <span class="block text-[10px] tracking-wider text-gray-500 uppercase">Horas</span>
        </div>
        <div class="rounded-xl bg-gray-50 p-2.5">
          <span id="cd-minutes" class="font-serif text-2xl font-bold text-gray-900">00</span>
          <span class="block text-[10px] tracking-wider text-gray-500 uppercase">Min</span>
        </div>
        <div class="rounded-xl bg-gray-50 p-2.5">
          <span id="cd-seconds" class="font-serif text-2xl font-bold text-gray-900">00</span>
          <span class="block text-[10px] tracking-wider text-gray-500 uppercase">Seg</span>
        </div>
      </div>
    </section>

    <!-- Ficha de Ubicacion y GPS -->
    <section class="mt-8 rounded-2xl border border-gray-200/80 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-2 text-xs font-semibold tracking-widest text-gray-400 uppercase">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Lugar de Recepcion</span>
      </div>
      <h2 class="mt-3 font-serif text-2xl font-bold text-gray-900">{event.location_name}</h2>
      <p class="mt-1 text-sm text-gray-600">{event.location_address}</p>

      <div class="mt-5 grid grid-cols-2 gap-3">
        {event.location_maps_url && (
          <a
            href={event.location_maps_url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl border border-gray-300 bg-gray-50 py-3 text-xs font-semibold text-gray-800 transition hover:bg-gray-100"
          >
            <span>Google Maps</span>
          </a>
        )}
        {event.location_waze_url && (
          <a
            href={event.location_waze_url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl border border-gray-300 bg-gray-50 py-3 text-xs font-semibold text-gray-800 transition hover:bg-gray-100"
          >
            <span>Waze</span>
          </a>
        )}
      </div>
    </section>

    <!-- Itinerario -->
    <section class="mt-8 rounded-2xl border border-gray-200/80 bg-white p-6 shadow-sm">
      <span class="text-xs font-semibold tracking-widest text-gray-400 uppercase">Itinerario del Evento</span>
      <ol class="mt-5 space-y-4 border-l border-gray-200 pl-4">
        {itineraryItems.map((item) => (
          <li class="relative">
            <span class="absolute -left-[21px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-gray-900"></span>
            <p class="text-sm font-medium text-gray-900">{item}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Codigo de Vestimenta y Mesa de Regalos -->
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <section class="rounded-2xl border border-gray-200/80 bg-white p-5 shadow-sm">
        <span class="text-[11px] font-semibold tracking-widest text-gray-400 uppercase">Codigo de Vestimenta</span>
        <p class="mt-2 font-serif text-lg font-bold text-gray-900">{event.dress_code || 'Formal'}</p>
      </section>

      <section class="rounded-2xl border border-gray-200/80 bg-white p-5 shadow-sm">
        <span class="text-[11px] font-semibold tracking-widest text-gray-400 uppercase">Mesa de Regalos</span>
        <p class="mt-2 text-xs font-medium leading-relaxed text-gray-700">{event.gift_registry_info || 'Agradecemos tu presencia y carino.'}</p>
      </section>
    </div>

  </main>

  <!-- Boton Flotante Inferior de RSVP -->
  <div class="fixed inset-x-0 bottom-0 z-30 border-t border-gray-200/80 bg-white/90 p-4 backdrop-blur-md">
    <div class="mx-auto max-w-lg">
      <button
        id="trigger-open-rsvp"
        type="button"
        class="w-full rounded-2xl bg-gray-950 py-4 text-center text-xs font-bold tracking-widest text-white uppercase shadow-lg transition active:scale-[0.98] hover:bg-black"
      >
        Confirmar Asistencia (RSVP)
      </button>
    </div>
  </div>

  <!-- Modal de confirmacion -->
  <RSVPModal slug={event.slug} />

</Layout>

<script define:vars={{ eventDateStr: event.event_date }}>
  // Manejador del boton flotante
  document.getElementById('trigger-open-rsvp')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-rsvp-modal'));
  });

  // Cuenta regresiva
  function updateCountdown() {
    const target = new Date(eventDateStr).getTime();
    const now = new Date().getTime();
    const diff = target - now;

    if (diff <= 0) {
      document.getElementById('cd-days').textContent = '00';
      document.getElementById('cd-hours').textContent = '00';
      document.getElementById('cd-minutes').textContent = '00';
      document.getElementById('cd-seconds').textContent = '00';
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    const pad = (n) => String(n).padStart(2, '0');
    document.getElementById('cd-days').textContent = pad(days);
    document.getElementById('cd-hours').textContent = pad(hours);
    document.getElementById('cd-minutes').textContent = pad(minutes);
    document.getElementById('cd-seconds').textContent = pad(seconds);
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
