---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Panel de Administracion — Vocatus & Animus" theme="dark">
  
  <div class="min-h-screen bg-[#121318] text-white flex flex-col lg:flex-row">
    
    <!-- Barra Lateral Izquierda estilo Momentiia -->
    <aside class="w-full lg:w-64 border-b lg:border-b-0 lg:border-r border-white/10 bg-[#16181f] p-6 flex flex-col justify-between">
      
      <div>
        <!-- Logo / Marca -->
        <div class="flex items-center gap-2 mb-8">
          <span class="text-xs uppercase tracking-widest font-bold text-emerald-400">Animus &bull; Vocatus</span>
        </div>

        <!-- Navegacion Principal -->
        <nav class="space-y-1.5 text-sm font-medium">
          <a href="/admin" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-white/10 text-white shadow-sm">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Inicio</span>
          </a>

          <a href="/admin/boda-carlos-y-sofia" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 transition">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Mis albumes</span>
          </a>

          <button
            id="btn-open-quote-modal"
            type="button"
            class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-gray-400 hover:text-white hover:bg-white/5 transition text-left"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span>Cotizador en linea</span>
          </button>
        </nav>
      </div>

      <!-- Perfil inferior del anfitrion -->
      <div class="pt-6 border-t border-white/10 mt-6 lg:mt-0">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-9 w-9 rounded-full bg-white/20 border border-white/30 flex items-center justify-center font-bold text-sm text-white">
            C
          </div>
          <div>
            <span class="block text-xs font-bold text-white">Carlos Morales</span>
            <span class="block text-[11px] text-gray-400">carlos@ejemplo.com</span>
          </div>
        </div>
        <a href="/" class="text-xs text-gray-500 hover:text-gray-300 transition block">
          Cerrar sesion
        </a>
      </div>

    </aside>

    <!-- Contenido Principal del Dashboard -->
    <main class="flex-1 p-6 sm:p-10 lg:p-12 max-w-6xl">
      
      <!-- Saludo Superior -->
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-white tracking-wide">Hola, Carlos</h1>
        <p class="text-sm text-gray-400 mt-1">Esto es lo que tienes entre manos.</p>
      </div>

      <!-- Tarjeta Destacada "Tu Proximo Evento" estilo Momentiia -->
      <div class="relative overflow-hidden rounded-3xl border border-white/15 bg-gradient-to-r from-[#1e2028] via-[#242733] to-[#1c1e26] p-6 sm:p-8 shadow-2xl mb-8">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          
          <div class="flex items-center gap-5">
            <!-- Portada en miniatura -->
            <img
              src="https://images.unsplash.com/photo-1519741497674-611481863552?w=300&auto=format&fit=crop&q=80"
              alt="Portada de la boda"
              class="h-24 w-24 sm:h-28 sm:w-28 rounded-2xl object-cover border border-white/20 shadow-lg"
            />
            <div>
              <span class="text-[11px] uppercase tracking-widest text-gray-400 font-semibold">Tu proximo evento</span>
              <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Boda Carlos & Sofia</h2>
              
              <div class="flex flex-wrap items-center gap-2.5 mt-2 text-xs">
                <span class="font-bold text-amber-300">Faltan 34 dias</span>
                <span class="text-gray-400">&bull; 25 de octubre de 2026</span>
                <span class="px-2.5 py-0.5 rounded-full bg-amber-400/20 text-amber-300 font-semibold border border-amber-400/30">
                  Plan Legado Pro
                </span>
              </div>
            </div>
          </div>

          <!-- Boton Abrir -->
          <a
            href="/admin/boda-carlos-y-sofia"
            class="flex items-center gap-2 rounded-2xl bg-[#d4af37] px-6 py-3 text-xs font-bold text-black uppercase tracking-wider shadow-xl hover:bg-[#e6c24d] transition active:scale-95"
          >
            <span>Abrir panel</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

        </div>

        <!-- Barra de Progreso de Preparacion (8 de 9 pasos) -->
        <div class="mt-6 pt-5 border-t border-white/10">
          <div class="flex justify-between text-xs text-gray-400 mb-1.5">
            <span class="font-medium text-gray-300">8 de 9 pasos listos</span>
            <span class="font-bold text-amber-300">89%</span>
          </div>
          <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
            <div class="h-full bg-gradient-to-r from-amber-400 to-[#d4af37] rounded-full" style="width: 89%"></div>
          </div>
        </div>

      </div>

      <!-- Tarjetas de Metricas Rapidas -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        
        <div class="rounded-2xl border border-white/10 bg-[#191b22] p-5 shadow-lg">
          <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold">Albumes Activos</span>
          <div class="mt-2 text-3xl font-bold text-white">1</div>
          <span class="text-xs text-gray-500 mt-1 block">Boda Carlos & Sofia</span>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#191b22] p-5 shadow-lg">
          <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold">Fotos y Videos Guardados</span>
          <div class="mt-2 text-3xl font-bold text-white">6</div>
          <span class="text-xs text-emerald-400 mt-1 block">Boveda sincronizada</span>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#191b22] p-5 shadow-lg">
          <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold">Pases RSVP Confirmados</span>
          <div class="mt-2 text-3xl font-bold text-white">7</div>
          <span class="text-xs text-gray-500 mt-1 block">De 11 pases asignados</span>
        </div>

      </div>

      <!-- Seccion de Acciones Rapidas estilo Momentiia -->
      <div class="mb-8">
        <h3 class="text-xs uppercase tracking-widest text-gray-400 font-semibold mb-3">Acciones Rapidas</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <button
            id="btn-quick-quote"
            type="button"
            class="flex items-center justify-between p-5 rounded-2xl border border-white/10 bg-[#191b22] hover:border-white/30 transition text-left group"
          >
            <div class="flex items-center gap-3.5">
              <div class="h-10 w-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </div>
              <div>
                <span class="block text-sm font-bold text-white">Crear o cotizar un evento</span>
                <span class="block text-xs text-gray-400">Calcula precios y almacenamiento</span>
              </div>
            </div>
            <svg class="h-4 w-4 text-gray-500 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <a
            href="/admin/boda-carlos-y-sofia"
            class="flex items-center justify-between p-5 rounded-2xl border border-white/10 bg-[#191b22] hover:border-white/30 transition text-left group"
          >
            <div class="flex items-center gap-3.5">
              <div class="h-10 w-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="block text-sm font-bold text-white">Ver boveda de recuerdos</span>
                <span class="block text-xs text-gray-400">Moderar fotos y descargar ZIP</span>
              </div>
            </div>
            <svg class="h-4 w-4 text-gray-500 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>

          <a
            href="/admin/print/boda-carlos-y-sofia"
            class="flex items-center justify-between p-5 rounded-2xl border border-white/10 bg-[#191b22] hover:border-white/30 transition text-left group"
          >
            <div class="flex items-center gap-3.5">
              <div class="h-10 w-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
              </div>
              <div>
                <span class="block text-sm font-bold text-white">Descargar carteles para mesa</span>
                <span class="block text-xs text-gray-400">Plantillas con codigo QR y PIN</span>
              </div>
            </div>
            <svg class="h-4 w-4 text-gray-500 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>

          <a
            href="/v/boda-carlos-y-sofia"
            target="_blank"
            class="flex items-center justify-between p-5 rounded-2xl border border-white/10 bg-[#191b22] hover:border-white/30 transition text-left group"
          >
            <div class="flex items-center gap-3.5">
              <div class="h-10 w-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <div>
                <span class="block text-sm font-bold text-white">Ver como invitado</span>
                <span class="block text-xs text-gray-400">Abrir invitacion en vivo</span>
              </div>
            </div>
            <svg class="h-4 w-4 text-gray-500 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

        </div>
      </div>

    </main>

  </div>

  <!-- Modal Interactivo de Cotizador / Alta de Eventos -->
  <div id="quote-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-3xl border border-white/15 bg-[#1a1c24] p-6 sm:p-8 shadow-2xl">
      
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-400 font-semibold">Calculadora Comercial</span>
          <h3 class="text-xl font-bold text-white mt-0.5">Cotizar Nuevo Evento</h3>
        </div>
        <button id="btn-close-quote" type="button" class="p-1 rounded-lg text-gray-400 hover:text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-xs text-gray-400 font-medium mb-1.5">Tipo de Evento</label>
          <select id="quote-event-type" class="w-full rounded-xl bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm text-white focus:outline-none">
            <option value="boda">Boda de Gala</option>
            <option value="xv">XV Anos</option>
            <option value="graduacion">Graduacion</option>
            <option value="aniversario">Aniversario</option>
            <option value="corporativo">Evento Corporativo</option>
          </select>
        </div>

        <div>
          <label class="block text-xs text-gray-400 font-medium mb-1.5">Alcance y Modulos Contratados</label>
          <select id="quote-tier" class="w-full rounded-xl bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm text-white focus:outline-none">
            <option value="esencial">Pacto Esencial — Solo Invitaciones & RSVP (Sin Boveda)</option>
            <option value="sincronia">Sincronia Total — Invitacion + Boveda Fotos (15 GB)</option>
            <option value="legado" selected>Legado Pro — Suite Completa + Muro en Vivo + Video (50 GB)</option>
          </select>
        </div>

        <div>
          <div class="flex justify-between text-xs text-gray-400 mb-1.5">
            <span>Numero estimado de invitados:</span>
            <span id="quote-guests-display" class="font-bold text-white">150 personas</span>
          </div>
          <input
            type="range"
            id="quote-guests-range"
            min="30"
            max="600"
            step="10"
            value="150"
            class="w-full accent-amber-400 cursor-pointer"
          />
        </div>

        <!-- Resultado Calculado en Vivo -->
        <div class="mt-6 p-4 rounded-2xl bg-[#14151a] border border-white/10 space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-gray-400">Cuota de Almacenamiento R2:</span>
            <span id="quote-storage-calc" class="font-bold text-emerald-400">50 GB (Calidad Original)</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-gray-400">Empaquetado masivo ZIP:</span>
            <span class="font-bold text-white">Incluido (Vigencia 7 dias)</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-gray-400">Muro en Vivo (Live Wall):</span>
            <span id="quote-livewall-calc" class="font-bold text-emerald-400">Habilitado para proyector</span>
          </div>
          <div class="pt-3 border-t border-white/10 flex justify-between items-center">
            <span class="text-sm font-bold text-white">Precio Sugerido:</span>
            <span id="quote-price-calc" class="text-xl font-extrabold text-amber-400">$3,499 MXN</span>
          </div>
        </div>

        <button
          type="button"
          id="btn-confirm-quote"
          class="w-full mt-4 py-3 rounded-xl bg-white text-black font-bold uppercase tracking-wider text-xs shadow-lg hover:bg-gray-200 transition active:scale-95"
        >
          Crear Evento en Plataforma
        </button>

      </div>

    </div>
  </div>

</Layout>

<script>
  const quoteModal = document.getElementById('quote-modal');
  const btnOpenQuote = document.getElementById('btn-open-quote-modal');
  const btnQuickQuote = document.getElementById('btn-quick-quote');
  const btnCloseQuote = document.getElementById('btn-close-quote');
  const btnConfirmQuote = document.getElementById('btn-confirm-quote');

  const rangeGuests = document.getElementById('quote-guests-range') as HTMLInputElement | null;
  const displayGuests = document.getElementById('quote-guests-display');
  const selectTier = document.getElementById('quote-tier') as HTMLSelectElement | null;
  const storageCalc = document.getElementById('quote-storage-calc');
  const livewallCalc = document.getElementById('quote-livewall-calc');
  const priceCalc = document.getElementById('quote-price-calc');

  function openModal() {
    quoteModal?.classList.remove('hidden');
  }

  function closeModal() {
    quoteModal?.classList.add('hidden');
  }

  btnOpenQuote?.addEventListener('click', openModal);
  btnQuickQuote?.addEventListener('click', openModal);
  btnCloseQuote?.addEventListener('click', closeModal);

  function recalculate() {
    if (!rangeGuests || !selectTier) return;
    const guests = parseInt(rangeGuests.value, 10);
    if (displayGuests) displayGuests.textContent = `${guests} personas`;

    const tier = selectTier.value;
    if (tier === 'esencial') {
      if (storageCalc) storageCalc.textContent = 'No incluido';
      if (livewallCalc) livewallCalc.textContent = 'No incluido';
      if (priceCalc) priceCalc.textContent = '$1,299 MXN';
    } else if (tier === 'sincronia') {
      if (storageCalc) storageCalc.textContent = '15 GB (Solo Fotos)';
      if (livewallCalc) livewallCalc.textContent = 'Opcional';
      if (priceCalc) priceCalc.textContent = '$2,499 MXN';
    } else {
      if (storageCalc) storageCalc.textContent = '50 GB (Fotos y Videos)';
      if (livewallCalc) livewallCalc.textContent = 'Habilitado para proyector';
      if (priceCalc) priceCalc.textContent = '$3,899 MXN';
    }
  }

  rangeGuests?.addEventListener('input', recalculate);
  selectTier?.addEventListener('change', recalculate);

  btnConfirmQuote?.addEventListener('click', () => {
    alert('Cotizacion guardada. El evento estara disponible en tu listado.');
    closeModal();
  });
</script>
