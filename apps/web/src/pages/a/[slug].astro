---
import Layout from '../../layouts/Layout.astro';
import PinGate from '../../components/PinGate.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import ReelsViewer from '../../components/ReelsViewer.astro';
import UploaderModal from '../../components/UploaderModal.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'boda-carlos-y-sofia' } },
  ];
}

const { slug } = Astro.params;
const eventSlug = slug || 'boda-carlos-y-sofia';
---

<Layout title="Boveda de Recuerdos — Animus" theme="dark">
  
  <!-- Barra superior -->
  <header class="sticky top-0 z-30 flex items-center justify-between border-b border-white/10 bg-[#181a20]/95 px-4 py-3.5 backdrop-blur-md">
    <a href={`/v/${eventSlug}`} class="flex items-center gap-1.5 text-sm font-medium text-gray-300 hover:text-white transition">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Invitacion</span>
    </a>

    <div class="text-center">
      <span class="block text-xs font-semibold tracking-widest text-gray-400 uppercase">Animus</span>
      <h1 class="text-sm font-bold text-white tracking-wide">Boda Carlos & Sofia</h1>
    </div>

    <!-- Espacio equilibrado para centrado -->
    <div class="w-16"></div>
  </header>

  <!-- Contenido Principal: Galeria tipo telefono -->
  <main class="mx-auto max-w-lg min-h-screen">
    <GalleryGrid slug={eventSlug} />
  </main>

  <!-- Componentes modales y reproductores -->
  <PinGate slug={eventSlug} />
  <ReelsViewer />
  <UploaderModal slug={eventSlug} />

</Layout>
