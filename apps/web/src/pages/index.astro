---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vocatus & Animus — Suite para Eventos Sociales" theme="editorial">
  <main class="mx-auto max-w-lg px-6 py-16 text-center">
    
    <span class="text-xs font-semibold tracking-[0.3em] text-gray-400 uppercase">Suite Web para Eventos Sociales</span>
    <h1 class="mt-4 font-serif text-4xl font-bold tracking-tight text-gray-950 sm:text-5xl">
      Vocatus & Animus
    </h1>
    <p class="mt-4 text-sm text-gray-600 leading-relaxed">
      Invitaciones interactivas con confirmacion inteligente (RSVP) y boveda colaborativa de fotos en tiempo real.
    </p>

    <!-- Fichas de Acceso Rapido a Modulos -->
    <div class="mt-10 space-y-4 text-left">
      
      <!-- Modulo Vocatus -->
      <a
        href="/v/boda-carlos-y-sofia"
        class="block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-gray-900 hover:shadow-md"
      >
        <span class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">Fase Pre-Evento</span>
        <h2 class="mt-1 font-serif text-xl font-bold text-gray-900">Vocatus ("El Llamado")</h2>
        <p class="mt-1 text-xs text-gray-600 leading-relaxed">
          Invitacion digital interactiva, cuenta regresiva, mapas Waze/Google Maps y confirmacion de pases RSVP.
        </p>
        <span class="mt-4 inline-flex items-center text-xs font-bold text-gray-900">
          <span>Abrir Invitacion Demo</span>
          <span class="ml-1">&rarr;</span>
        </span>
      </a>

      <!-- Modulo Animus -->
      <a
        href="/a/boda-carlos-y-sofia?pin=4821"
        class="block rounded-2xl border border-gray-900 bg-black p-6 text-white shadow-md transition hover:bg-neutral-900"
      >
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold tracking-widest text-insta-gray uppercase">El Dia de la Fiesta</span>
          <span class="rounded bg-white/20 px-2 py-0.5 text-[10px] font-semibold text-white">PIN 4821</span>
        </div>
        <h2 class="mt-1 font-serif text-xl font-bold text-white">Animus ("La Memoria")</h2>
        <p class="mt-1 text-xs text-gray-400 leading-relaxed">
          Boveda de fotos y videos en centros de mesa con visor inmersivo estilo Reels y galeria tipo telefono.
        </p>
        <span class="mt-4 inline-flex items-center text-xs font-bold text-white">
          <span>Entrar a la Boveda Demo</span>
          <span class="ml-1">&rarr;</span>
        </span>
      </a>

    </div>

    <footer class="mt-16 text-center text-xs text-gray-400">
      <span>Vocatus & Animus &bull; Version 1.0 &bull; Editorial & Industrial Minimalist</span>
    </footer>

  </main>
</Layout>
