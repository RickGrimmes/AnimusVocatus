        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });

        revealElements.forEach(function (el) {
          observer.observe(el);
        });
      } else {
        revealElements.forEach(function (el) {
          el.classList.add('reveal-visible');
        });
      }

      // 2. Titular Dinamico con Rotacion de Palabras (Estilo Momentiia)
      var words = ['boda', 'graduación', 'XV años', 'aniversario', 'cumpleaños'];
      var wordIndex = 0;
      var rotatingWordEl = document.getElementById('rotating-word');

      if (rotatingWordEl) {
        setInterval(function () {
          wordIndex = (wordIndex + 1) % words.length;
          rotatingWordEl.style.opacity = '0';
          rotatingWordEl.style.transform = 'translateY(6px)';
          setTimeout(function () {
            rotatingWordEl.textContent = words[wordIndex];
            rotatingWordEl.style.opacity = '1';
            rotatingWordEl.style.transform = 'translateY(0)';
          }, 300);
        }, 3200);
        rotatingWordEl.style.transition = 'all 0.3s ease';
      }

      // 3. Sincronizacion Interactiva de la Seccion "Tres Pasos y Ya"
      var stepTabs = document.querySelectorAll('.step-tab');
      var stepImg = document.getElementById('step-feature-img');
      var stepBadge = document.getElementById('step-badge-text');
      var stepTitle = document.getElementById('step-overlay-title');

      var STEP_DATA = {
        '1': {
          img: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1000&q=80',
          badge: 'Paso 01 • Configuración Express',
          title: 'Ana & Luis • 14 . 09 . 2026'
        },
        '2': {
          img: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1000&q=80',
          badge: 'Paso 02 • Centros de Mesa con QR',
          title: 'Escanea y sube sin descargar apps'
        },
        '3': {
          img: 'https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=1000&q=80',
          badge: 'Paso 03 • Proyección y Descarga ZIP',
          title: 'Mural en vivo durante toda la fiesta'
        }
      };

      stepTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var step = tab.getAttribute('data-step');
          stepTabs.forEach(function (t) {
            t.classList.remove('border-2', 'border-amber-600');
            t.classList.add('border', 'border-gray-200');
          });
          tab.classList.remove('border', 'border-gray-200');
          tab.classList.add('border-2', 'border-amber-600');

          if (STEP_DATA[step] && stepImg && stepBadge && stepTitle) {
            stepImg.style.opacity = '0.4';
            setTimeout(function () {
              stepImg.src = STEP_DATA[step].img;
              stepBadge.textContent = STEP_DATA[step].badge;
              stepTitle.textContent = STEP_DATA[step].title;
              stepImg.style.opacity = '1';
            }, 250);
          }
        });
      });

      // 4. Selector Interactivo de Tipos de Eventos ("Para tus Invitados")
      var catCards = document.querySelectorAll('.category-card');
      var phoneImg1 = document.getElementById('category-phone-img-1');
      var phoneImg2 = document.getElementById('category-phone-img-2');

      var CAT_DATA = {
        'bodas': {
          img1: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=400&q=80',
          img2: 'https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=400&q=80'
        },
        'xv': {
          img1: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=400&q=80',
          img2: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=400&q=80'
        },
        'bautizos': {
          img1: 'https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=400&q=80',
          img2: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=400&q=80'
        },
        'graduaciones': {
          img1: 'https://images.unsplash.com/photo-1523580494863-6f3031224c94?auto=format&fit=crop&w=400&q=80',
          img2: 'https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=400&q=80'
        }
      };

      catCards.forEach(function (card) {
        card.addEventListener('click', function () {
          var cat = card.getAttribute('data-category');
          catCards.forEach(function (c) {
            c.classList.remove('border-2', 'border-amber-600', 'bg-gradient-to-r', 'from-amber-50/70', 'to-white');
            c.classList.add('border', 'border-gray-200', 'bg-white');
          });
          card.classList.remove('border', 'border-gray-200', 'bg-white');
          card.classList.add('border-2', 'border-amber-600', 'bg-gradient-to-r', 'from-amber-50/70', 'to-white');

          if (CAT_DATA[cat] && phoneImg1 && phoneImg2) {
            phoneImg1.style.opacity = '0.3';
            phoneImg2.style.opacity = '0.3';
            setTimeout(function () {
              phoneImg1.src = CAT_DATA[cat].img1;
              phoneImg2.src = CAT_DATA[cat].img2;
              phoneImg1.style.opacity = '1';
              phoneImg2.style.opacity = '1';
            }, 250);
          }
        });
      });

      // 5. Motor del Cotizador Comercial
      var TIER_PRICES = { essential: 1990, pro: 3490, vip: 5990 };
      var TIER_NAMES = { essential: 'Paquete Esencial', pro: 'Paquete Memoria Pro', vip: 'Paquete Boda Magna VIP' };

      var currentTier = 'pro';
      var currentGuests = 150;
      var currentMonths = 3;

      var guestsSlider = document.getElementById('calc-guests-slider');
      var guestsLabel = document.getElementById('calc-guests-label');
      var tierBtns = document.querySelectorAll('.calc-tier-btn');
      var monthBtns = document.querySelectorAll('.calc-months-btn');

      var addonLiveWall = document.getElementById('addon-livewall');
      var addonZip = document.getElementById('addon-zip');
      var addonDomain = document.getElementById('addon-domain');

      var totalDisplay = document.getElementById('calc-total-display');
      var summaryTierName = document.getElementById('summary-tier-name');
      var summaryTierPrice = document.getElementById('summary-tier-price');
      var summaryGuestsInfo = document.getElementById('summary-guests-info');
      var summaryGuestsPrice = document.getElementById('summary-guests-price');
      var summaryMonthsInfo = document.getElementById('summary-months-info');
      var summaryMonthsPrice = document.getElementById('summary-months-price');
      var summaryAddonsInfo = document.getElementById('summary-addons-info');
      var summaryAddonsPrice = document.getElementById('summary-addons-price');

      function calculateTotal() {
        var basePrice = TIER_PRICES[currentTier] || 3490;

        var guestExtra = 0;
        if (currentGuests > 150) {
          guestExtra = Math.ceil((currentGuests - 150) / 50) * 450;
        }

        var monthsExtra = 0;
        if (currentMonths === 6) monthsExtra = 690;
        if (currentMonths === 12) monthsExtra = 1290;

        var addonsExtra = 0;
        var activeAddons = [];
        if (addonLiveWall && addonLiveWall.checked) {
          addonsExtra += 1490;
          activeAddons.push('Live Wall');
        }
        if (addonZip && addonZip.checked) {
          addonsExtra += 690;
          activeAddons.push('Empaquetador ZIP');
        }
        if (addonDomain && addonDomain.checked) {
          addonsExtra += 990;
          activeAddons.push('Dominio propio');
        }

        var total = basePrice + guestExtra + monthsExtra + addonsExtra;

        if (totalDisplay) totalDisplay.textContent = '$' + total.toLocaleString('es-MX');
        if (summaryTierName) summaryTierName.textContent = TIER_NAMES[currentTier];
        if (summaryTierPrice) summaryTierPrice.textContent = '$' + basePrice.toLocaleString('es-MX');

        if (summaryGuestsInfo) summaryGuestsInfo.textContent = 'Hasta ' + currentGuests + ' invitados';
        if (summaryGuestsPrice) summaryGuestsPrice.textContent = guestExtra > 0 ? '+$' + guestExtra.toLocaleString('es-MX') : '$0';

        if (summaryMonthsInfo) summaryMonthsInfo.textContent = 'Resguardo por ' + currentMonths + (currentMonths === 1 ? ' mes' : (currentMonths === 12 ? ' año' : ' meses'));
        if (summaryMonthsPrice) summaryMonthsPrice.textContent = monthsExtra > 0 ? '+$' + monthsExtra.toLocaleString('es-MX') : '$0';

        if (summaryAddonsInfo) summaryAddonsInfo.textContent = activeAddons.length > 0 ? activeAddons.join(' + ') : 'Sin complementos';
        if (summaryAddonsPrice) summaryAddonsPrice.textContent = addonsExtra > 0 ? '+$' + addonsExtra.toLocaleString('es-MX') : '$0';
      }

      if (guestsSlider) {
        guestsSlider.addEventListener('input', function (e) {
          currentGuests = parseInt(e.target.value, 10);
          if (guestsLabel) guestsLabel.textContent = currentGuests + ' personas';
          calculateTotal();
        });
      }

      tierBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          tierBtns.forEach(function (b) {
            b.classList.remove('border-2', 'border-amber-600', 'bg-amber-50/40');
            b.classList.add('border', 'border-gray-200', 'bg-white');
          });
          btn.classList.remove('border', 'border-gray-200', 'bg-white');
          btn.classList.add('border-2', 'border-amber-600', 'bg-amber-50/40');
          currentTier = btn.getAttribute('data-tier') || 'pro';
          calculateTotal();
        });
      });

      monthBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          monthBtns.forEach(function (b) {
            b.classList.remove('border-2', 'border-amber-600', 'bg-amber-50', 'text-amber-900', 'font-bold');
            b.classList.add('border', 'border-gray-200', 'bg-white', 'text-gray-700', 'font-semibold');
          });
          btn.classList.remove('border', 'border-gray-200', 'bg-white', 'text-gray-700', 'font-semibold');
          btn.classList.add('border-2', 'border-amber-600', 'bg-amber-50', 'text-amber-900', 'font-bold');
          currentMonths = parseInt(btn.getAttribute('data-months'), 10) || 3;
          calculateTotal();
        });
      });

      if (addonLiveWall) addonLiveWall.addEventListener('change', calculateTotal);
      if (addonZip) addonZip.addEventListener('change', calculateTotal);
      if (addonDomain) addonDomain.addEventListener('change', calculateTotal);

      var btnContract = document.getElementById('btn-contract');
      var contractFeedback = document.getElementById('contract-feedback');
      if (btnContract && contractFeedback) {
        btnContract.addEventListener('click', function () {
          contractFeedback.classList.remove('hidden');
          btnContract.textContent = 'Solicitud Registrada Exitosamente';
          btnContract.disabled = true;
          btnContract.classList.add('opacity-70', 'cursor-not-allowed');
        });
      }

      calculateTotal();
    })();
  </script>

</Layout>
