---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Aevum — Todas las fotos de tu evento en un solo lugar" theme="editorial">
  
  <!-- Barra de Navegacion Superior estilo Momentiia -->
  <header class="sticky top-0 z-50 border-b border-amber-900/10 bg-[#fffdf9]/90 backdrop-blur-md transition-all">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
      
      <!-- Logotipo de Marca -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="flex h-9 items-center justify-center px-2.5 rounded-xl border border-amber-500/30 bg-[#fdfaf3] text-gray-950 font-serif font-bold text-sm shadow-sm group-hover:border-amber-600 group-hover:bg-amber-50/50 transition">
          <span class="text-amber-600 font-mono font-normal mr-0.5">[</span><span class="font-aevum tracking-wider font-bold">AE</span><span class="text-amber-600 font-mono font-normal ml-0.5">]</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-aevum text-2xl font-bold tracking-wider text-gray-950">aevum</span>
          <span class="h-1.5 w-1.5 rounded-full bg-amber-600"></span>
        </div>
      </a>

      <!-- Enlaces de Navegacion -->
      <nav class="hidden items-center gap-8 text-xs font-semibold tracking-wider text-gray-600 uppercase md:flex">
        <a href="#como-funciona" class="transition hover:text-amber-800">Cómo funciona</a>
        <a href="#comparativa" class="transition hover:text-amber-800">Vs. WhatsApp</a>
        <a href="#para-invitados" class="transition hover:text-amber-800">Para tus invitados</a>
        <a href="#cotizador" class="transition hover:text-amber-800">Precios</a>
        <a href="#demos" class="transition hover:text-amber-800">Demos</a>
      </nav>

      <!-- Acciones de Cabecera -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-1 text-xs text-gray-500 pr-2 border-r border-gray-200">
          <svg class="h-3.5 w-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span class="font-medium">Español</span>
        </div>

        <a
          href="/admin"
          class="inline-flex items-center gap-2 rounded-full border border-amber-900/15 bg-white px-4 py-2 text-xs font-bold text-gray-800 shadow-sm transition hover:border-gray-950 hover:bg-gray-50"
        >
          <svg class="h-3.5 w-3.5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span>Mi panel</span>
        </a>
      </div>

    </div>
  </header>

  <main class="overflow-x-hidden">
    
    <!-- Seccion 1: HERO PRINCIPAL CON ICONOS FLOTANTES Y ROTACION DE PALABRA -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#fffdf9] via-[#fbf6ea] to-[#fffdf9] pt-16 pb-20 lg:pt-24 lg:pb-28">
      
      <!-- Íconos Flotantes Sutiles (Decoración Orgánica estilo Momentiia) -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <!-- Cámara flotante izquierda -->
        <div class="animate-float absolute top-12 left-10 text-amber-800/15">
          <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>

        <!-- Corazón flotante centro-izq -->
        <div class="animate-float-delayed absolute top-36 left-[22%] text-amber-700/15">
          <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
          </svg>
        </div>

        <!-- Nota musical flotante derecha -->
        <div class="animate-float absolute top-20 right-28 text-amber-800/15">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
          </svg>
        </div>

        <!-- Video cámara flotante derecha-baja -->
        <div class="animate-float-delayed absolute top-48 right-[12%] text-amber-800/15">
          <svg class="h-9 w-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>

        <!-- Código QR flotante centro-der -->
        <div class="animate-float-slow absolute top-72 right-[26%] text-amber-700/15">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
          </svg>
        </div>

        <!-- Microfono flotante inferior-izq -->
        <div class="animate-float absolute bottom-24 left-[14%] text-amber-800/15">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
        </div>
      </div>

      <div class="relative mx-auto max-w-4xl px-6 text-center reveal-init">
        
        <!-- Titular Dinamico con Rotacion -->
        <h1 class="font-serif text-5xl font-bold tracking-tight text-gray-950 sm:text-6xl lg:text-7xl leading-[1.12]">
          Todas las fotos de tu
          <span class="relative inline-block text-amber-700 font-normal italic">
            <span id="rotating-word">boda</span>
            <span id="rotating-cursor" class="inline-block w-0.5 h-[0.85em] bg-amber-600 align-middle ml-1 animate-pulse"></span>
          </span>
          <br />
          en un solo lugar
        </h1>

        <!-- Subtitulo de Alta Conversion -->
        <p class="mx-auto mt-6 max-w-2xl text-base text-gray-600 leading-relaxed sm:text-lg">
          Tus invitados escanean un código QR y sus fotos y videos caen directo en tu álbum privado. Sin instalar nada, sin crear cuentas, sin andar pidiéndolas por el grupo de WhatsApp.
        </p>

        <!-- Botones Principales Pill -->
        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="#cotizador"
            class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-amber-600 via-amber-700 to-amber-800 px-8 py-4 text-sm font-bold text-white shadow-lg shadow-amber-700/25 transition hover:scale-105 active:scale-95"
          >
            <span>Crear mi evento</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/a/boda-carlos-y-sofia?pin=4821"
            class="inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-7 py-4 text-sm font-semibold text-gray-800 shadow-sm transition hover:border-gray-900 hover:text-gray-950"
          >
            <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Ver un álbum de ejemplo</span>
          </a>
        </div>

        <!-- 4 Sellos de Garantia Inline -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-semibold text-gray-600">
          <div class="flex items-center gap-1.5">
            <span class="text-amber-700 font-bold">✓</span>
            <span>Listo en 3 pasos</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-amber-700 font-bold">✓</span>
            <span>Tus invitados no instalan nada</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-amber-700 font-bold">✓</span>
            <span>Gratis para probar sin tarjeta</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-amber-700 font-bold">✓</span>
            <span>Sin perder calidad original</span>
          </div>
        </div>

      </div>

    </section>

    <!-- Seccion 2: CARRUSEL CONTINUO INFINITO CON NOTIFICACIONES FLOTANTES -->
    <section class="relative overflow-hidden py-10 bg-[#fffdf9]">
      
      <!-- Track Continuo Marquee -->
      <div class="relative w-full overflow-hidden py-6">
        <div class="animate-marquee gap-6 px-4 items-center">
          
          <!-- Tarjeta Foto 1 -->
          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=80"
              alt="Boda de muestra"
              class="h-96 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <!-- Tarjeta Foto 2 (Con Cartel QR) -->
          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&q=80"
              alt="Cartel con QR"
              class="h-80 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <!-- Tarjeta Foto 3 (Invitados felices) -->
          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=600&q=80"
              alt="Invitados en el evento"
              class="h-96 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <!-- Tarjeta Foto 4 (Mesa decorada con cartel) -->
          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=600&q=80"
              alt="Mesa decorada"
              class="h-80 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <!-- Tarjeta Foto 5 (Brindis) -->
          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=600&q=80"
              alt="Brindis nupcial"
              class="h-96 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <!-- Tarjeta Foto 6 (Fiesta y baile) -->
          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=600&q=80"
              alt="Fiesta en vivo"
              class="h-80 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <!-- Duplicado para loop sin saltos -->
          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=80"
              alt="Boda de muestra"
              class="h-96 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&q=80"
              alt="Cartel con QR"
              class="h-80 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

          <div class="w-64 sm:w-72 shrink-0 overflow-hidden rounded-3xl border border-amber-900/10 shadow-lg group">
            <img
              src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=600&q=80"
              alt="Invitados en el evento"
              class="h-96 w-full object-cover group-hover:scale-105 transition duration-700"
            />
          </div>

        </div>

        <!-- Notificaciones Flotantes en Tiempo Real (Estilo Momentiia) -->
        <div class="pointer-events-none absolute inset-0 flex items-center justify-between px-6 max-w-7xl mx-auto">
          
          <!-- Notificacion 1: Fotos nuevas -->
          <div class="hidden lg:flex items-center gap-3 rounded-2xl border border-amber-900/10 bg-white/95 px-4 py-3 shadow-xl backdrop-blur-md -translate-y-24 translate-x-4 animate-float">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-900">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-gray-950">12 fotos nuevas</p>
              <p class="text-[11px] text-gray-500">de Marisol - hace un momento</p>
            </div>
          </div>

          <!-- Notificación 2: Nota de voz -->
          <div class="hidden lg:flex items-center gap-3 rounded-2xl border border-amber-900/10 bg-white/95 px-4 py-3 shadow-xl backdrop-blur-md translate-y-28 -translate-x-4 animate-float-delayed">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-900">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-gray-950">Nota de voz recibida</p>
              <p class="text-[11px] text-gray-500">de la abuela - recién llegada</p>
            </div>
          </div>

        </div>

      </div>

      <!-- Barra de Confianza Aevum (Screenshot 2 bottom bar) -->
      <div class="mt-8 mx-auto max-w-5xl px-6">
        <p class="text-center text-[10px] font-bold tracking-[0.25em] text-gray-400 uppercase">
          CON LA TECNOLOGÍA DE <span class="font-aevum text-sm text-amber-800 tracking-wider font-bold">AEVUM</span>
        </p>
        <div class="mt-4 grid grid-cols-2 gap-4 text-xs font-medium text-gray-600 sm:grid-cols-4">
          <div class="flex items-center justify-center gap-2 text-center">
            <svg class="h-4 w-4 text-amber-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Álbum privado: no aparece en Google</span>
          </div>
          <div class="flex items-center justify-center gap-2 text-center">
            <svg class="h-4 w-4 text-amber-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Tus fotos no se venden ni se usan para nada más</span>
          </div>
          <div class="flex items-center justify-center gap-2 text-center">
            <svg class="h-4 w-4 text-amber-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Descarga completa cuando quieras</span>
          </div>
          <div class="flex items-center justify-center gap-2 text-center">
            <svg class="h-4 w-4 text-amber-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <span>Se guardan sin perder calidad</span>
          </div>
        </div>
      </div>

    </section>

    <!-- Seccion 3: COMPARATIVA VS. WHATSAPP CON SMARTPHONE INTERACTIVO (Screenshot 3) -->
    <section id="comparativa" class="border-t border-b border-amber-900/10 bg-white py-24">
      <div class="mx-auto max-w-7xl px-6">
        
        <div class="grid items-center gap-16 lg:grid-cols-12">
          
          <!-- Columna Izquierda: Smartphone Interactivo Fotorrealista -->
          <div class="lg:col-span-5 flex justify-center reveal-init">
            <div class="relative w-[320px] sm:w-[350px] rounded-[48px] border-[10px] border-[#181a20] bg-black p-2.5 shadow-[0_25px_60px_-15px_rgba(180,83,9,0.3)]">
              
              <!-- Marco de Pantalla del Smartphone -->
              <div class="relative h-[640px] overflow-hidden rounded-[38px] bg-[#fbf9f5] border border-gray-200 flex flex-col justify-between">
                
                <!-- Notch / Dynamic Island -->
                <div class="absolute top-2 left-1/2 -translate-x-1/2 h-5 w-24 rounded-full bg-black z-30 flex items-center justify-between px-3">
                  <span class="h-2 w-2 rounded-full bg-neutral-800"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
                </div>

                <!-- Cabecera de Teléfono -->
                <div class="relative z-10 pt-8 pb-3 px-5 border-b border-gray-200/80 bg-white/90 backdrop-blur-md">
                  <div class="text-center">
                    <span class="text-[9px] uppercase tracking-widest text-amber-800 font-bold">Boda de Ana y Luis</span>
                    <p class="text-[10px] text-gray-400">237 fotos &bull; 14 mensajes</p>
                  </div>
                </div>

                <!-- Contenido Dinamico Simulando Movimiento Interno -->
                <div class="flex-1 overflow-hidden p-4 space-y-4 animate-phone-scroll">
                  
                  <!-- Grid de fotos "Lo último que llegó" -->
                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <span class="text-[11px] font-bold text-gray-900">Lo último que llegó</span>
                      <span class="text-[10px] font-bold text-amber-700">Ver todo</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                      <img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=300&q=80" alt="Foto 1" class="h-24 w-full object-cover rounded-xl shadow-sm" />
                      <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=300&q=80" alt="Foto 2" class="h-24 w-full object-cover rounded-xl shadow-sm" />
                      <img src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=300&q=80" alt="Foto 3" class="h-24 w-full object-cover rounded-xl shadow-sm" />
